{
  "components": {
    "schemas": {
      "CampaignPatch": {
        "properties": {
          "display_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "CampaignPatch",
        "type": "object"
      },
      "CampaignUpdate": {
        "properties": {
          "campaign_id": {
            "title": "Campaign Id",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "play_session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Play Session Id"
          }
        },
        "required": [
          "campaign_id"
        ],
        "title": "CampaignUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PolicyWrite": {
        "properties": {
          "area_pk": {
            "title": "Area Pk",
            "type": "integer"
          },
          "campaign_id": {
            "title": "Campaign Id",
            "type": "string"
          },
          "excluded": {
            "default": false,
            "title": "Excluded",
            "type": "boolean"
          },
          "high_target": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "High Target"
          },
          "low_target": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Low Target"
          },
          "priority": {
            "default": 0,
            "maximum": 10.0,
            "minimum": -10.0,
            "title": "Priority",
            "type": "integer"
          },
          "product_guid": {
            "title": "Product Guid",
            "type": "string"
          }
        },
        "required": [
          "campaign_id",
          "area_pk",
          "product_guid"
        ],
        "title": "PolicyWrite",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
