{
  "name": "anno-companion-dashboard",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "generate:api": "../../.venv/bin/python ../../tools/export_openapi.py && openapi-typescript openapi.json -o src/generated/openapi.d.ts",
    "check:api": "../../.venv/bin/python ../../tools/export_openapi.py --check && openapi-typescript openapi.json -o src/generated/openapi.d.ts --check",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "lucide-react": "1.31.0",
    "@xyflow/react": "12.11.3",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "28.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
