# Use forward slashes. Quote the value if your Windows user or folder name contains spaces.
ANNO_LOG_DIR=C:/Users/YOUR_WINDOWS_USER/Documents/Anno 117 - Pax Romana/log
ANNO_DATA_DIR=C:/Users/YOUR_WINDOWS_USER/Documents/Anno Companion/data

# The game may use a more specific filename; the data service polls every matching file.
ANNO_TELEMETRY_GLOB=*.log
DASHBOARD_PORT=8080
ANNO_POLL_INTERVAL_SECONDS=1
ANNO_STALE_AFTER_SECONDS=75

# Optional. Leave OPENAI_API_KEY empty to use deterministic recommendations only.
# The key is passed only to anno-companion-data and never to the dashboard image.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=30
